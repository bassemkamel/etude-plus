# ── Docker / infra ──────────────────────────────────────────
POSTGRES_USER=etude
POSTGRES_PASSWORD=etude
POSTGRES_DB=etudeplus
POSTGRES_PORT=5432
ADMINER_PORT=8080
REDIS_PORT=6379
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── API (NestJS) ────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
DATABASE_URL=postgresql://etude:etude@localhost:5432/etudeplus?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access-dev-only-32chars-min
JWT_REFRESH_SECRET=change-me-refresh-dev-only-32chars-min
CORS_ORIGINS=http://localhost:3000

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=etudeplus
S3_ACCESS_KEY=etude
S3_SECRET_KEY=etudeplus_minio
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=Étude+ <noreply@etudeplus.local>

ENABLE_PAYMENTS=false
ENABLE_STUDENT_PDF=true
ENABLE_AI=false
AI_PROVIDER=google
GOOGLE_GENAI_MODEL=gemini-3.6-flash
GOOGLE_GENAI_TIMEOUT_MS=600000
AI_API_KEY=

# ── Web (Next.js) ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_DEFAULT_LOCALE=fr
